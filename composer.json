{
    "name": "jorijn/laravel-security-checker",
    "description": "Checks your composer.lock against the Packagist security advisories database from Laravel, and reports vulnerabilities in the console, by email or in Slack.",
    "license": "MIT",
    "keywords": [
        "laravel",
        "security",
        "composer",
        "dependencies",
        "vulnerabilities",
        "audit",
        "packagist"
    ],
    "authors": [
        {
            "name": "Jorijn Schrijvershof",
            "email": "jorijn@jorijn.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "composer/semver": "^3.4",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/bus": "^12.0|^13.0|^14.0",
        "illuminate/console": "^12.0|^13.0|^14.0",
        "illuminate/http": "^12.0|^13.0|^14.0",
        "illuminate/mail": "^12.0|^13.0|^14.0",
        "illuminate/notifications": "^12.0|^13.0|^14.0",
        "illuminate/queue": "^12.0|^13.0|^14.0",
        "illuminate/support": "^12.0|^13.0|^14.0",
        "ext-json": "*"
    },
    "require-dev": {
        "enlightn/security-checker": "^2.0",
        "laravel/slack-notification-channel": "^3.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0|^11.0|^12.0",
        "phpunit/phpunit": "^11.0|^12.0|^13.0",
        "squizlabs/php_codesniffer": "^4.0",
        "symfony/yaml": "^7.0|^8.0"
    },
    "suggest": {
        "laravel/slack-notification-channel": "Required for security-check:slack.",
        "enlightn/security-checker": "Only needed for the deprecated \"enlightn\" driver (FriendsOfPHP database), which will be removed in 5.0."
    },
    "autoload": {
        "psr-4": {
            "Jorijn\\LaravelSecurityChecker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jorijn\\LaravelSecurityChecker\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs --standard=psr2 src/"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jorijn\\LaravelSecurityChecker\\ServiceProvider"
            ]
        }
    }
}
